# Local admin PIN used to unlock /admin. Not committed to git.
# When deploying, set the same variable in your host's project settings
# (e.g. Vercel → Project → Settings → Environment Variables).
VITE_ADMIN_PIN=141005

# --- Optional: persistent backend (see README "Persistent storage") ---
# Without these, the site works exactly as before (localStorage only).
# Set these to enable admin edits syncing live to every visitor/device.
MONGODB_URI=
MONGODB_DB=portfolio
# Must match VITE_ADMIN_PIN above — this is the server-side check used by
# /api/data to authorize writes. Never prefix this one with VITE_.
ADMIN_PIN=141005
